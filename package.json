{
  "name": "@mcco/web-kit",
  "version": "1.2.0-rc.2",
  "description": "Kit compartido de las webs MCCO Group: el Estándar Web v2 (layouts y componentes Astro, entidad del grupo, endpoints SEO/GEO, verificador mcco-check, generador de _headers y workflows reutilizables) y el estándar visual del grupo, Apple + antigravity (hoja, componentes, nube y campo). La salida sin Astro es una capa base sin minificar.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcabrera-pixel/mcco-web-kit.git"
  },
  "keywords": ["astro-component", "mcco", "withastro"],
  "exports": {
    "./config": "./config/astro.mjs",
    "./schemas": "./content/schemas.ts",
    "./layouts/*": "./layouts/*",
    "./components/*": "./components/*",
    "./pages/*": "./pages/*",
    "./data/*": "./data/*",
    "./endpoints/*": "./endpoints/*",
    "./lib/*": "./lib/*",
    "./styles/*": "./styles/*",
    "./functions/*": "./functions/*"
  },
  "bin": {
    "mcco-check": "scripts/check.mjs",
    "mcco-parity": "scripts/parity.mjs",
    "mcco-headers": "scripts/headers.mjs",
    "mcco-sitio": "scripts/sitio-ci.mjs",
    "mcco-estandar-copiar": "scripts/estandar-copiar.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "files": [
    "config", "content", "layouts", "components", "pages", "data", "endpoints",
    "lib", "styles", "scripts", "functions", "docs", "README.md"
  ],
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
