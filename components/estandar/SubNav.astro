---
// Sub-navegación del estándar: esmerilada, fija arriba al bajar, 52 px (48 en ≤ 640 px) con el título del sitio,
// enlaces de 12 px y la acción principal en píldora chica, siempre visible. En ≤ 833 px quedan el título y la acción;
// en ≤ 640 px la acción usa su textoCorto si lo tiene. Sobre un bloque negro a todo el ancho pasa a su versión oscura
// (lib/estandar/subnav.js). Va como hija directa de <body>: el position: sticky se mide contra su contenedor.
import '../../styles/estandar.css';

interface Enlace { href: string; texto: string }
interface Props {
  titulo: string;
  enlaces: Enlace[];
  accion: Enlace & { textoCorto?: string };
}
const { titulo, enlaces, accion } = Astro.props;
if (!titulo || !accion?.href || !accion?.texto) throw new Error('SubNav: falta titulo o accion { href, texto }.');
if (!Array.isArray(enlaces)) throw new Error('SubNav: falta enlaces (una lista, que puede ir vacía).');
const lleno = (v: unknown) => typeof v === 'string' && v.trim() !== '';
enlaces.forEach((e, i) => {
  const faltan = [!lleno(e?.href) && 'href', !lleno(e?.texto) && 'texto'].filter(Boolean);
  if (faltan.length) throw new Error(`SubNav: al enlace ${i + 1} le falta ${faltan.join(', ')}.`);
});
---
<div class="std-subnav">
  <div class="std-subnav__in">
    <span class="std-subnav__titulo">{titulo}</span>
    <nav class="std-subnav__nav" aria-label="Secciones">
      {enlaces.map((e) => <a class="std-subnav__enlace" href={e.href}>{e.texto}</a>)}
      <a class="std-pildora std-pildora--chica std-subnav__accion" href={accion.href}>
        {accion.textoCorto
          ? <Fragment><span class="std-subnav__largo">{accion.texto}</span><span class="std-subnav__corto">{accion.textoCorto}</span></Fragment>
          : accion.texto}
      </a>
    </nav>
  </div>
</div>

<script>import '../../lib/estandar/subnav.js';</script>

<style>
  .std-subnav {
    position: sticky; top: 0; z-index: 11; height: var(--std-subnav);
    border-bottom: 1px solid rgba(0, 0, 0, .08); background: rgba(250, 250, 252, .8);
    -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px);
    transition: background-color .3s, border-color .3s;
  }
  .std-subnav.is-oscura { border-bottom-color: rgba(255, 255, 255, .08); background: rgba(22, 22, 23, .8); }
  .std-subnav__in {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    max-width: 1024px; height: 100%; margin: 0 auto; padding: 0 22px;
  }
  .std-subnav__titulo {
    min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font: 600 21px/1.19 var(--std-fuente-display); letter-spacing: .011em;
  }
  .std-subnav.is-oscura .std-subnav__titulo { color: var(--std-parchment); }
  .std-subnav__nav { display: flex; flex: none; align-items: center; gap: 12px; }
  /* 12 px a la vista y 44 × 44 de área táctil; color y subrayado propios (la base los deja en color de acción). */
  .std-subnav__enlace {
    display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 0 6px;
    color: var(--std-tinta-80); font-size: 12px; letter-spacing: -.01em; text-decoration: none;
  }
  .std-subnav.is-oscura .std-subnav__enlace { color: var(--std-linea); }
  .std-subnav__accion { margin-left: 6px; }
  .std-subnav__corto { display: none; }

  @media (max-width: 833px) {
    .std-subnav__enlace { display: none; }
  }
  @media (max-width: 640px) {
    .std-subnav__titulo { font-size: 17px; }
    .std-subnav__largo { display: none; }
    .std-subnav__corto { display: inline; }
  }
  @media (prefers-reduced-motion: reduce) {
    .std-subnav { transition: none; }
  }
</style>
