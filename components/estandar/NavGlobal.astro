---
// Barra global del estándar (Apple + antigravity): negra, 44 px, logo del sitio y enlaces de 12 px. Bajo los 834 px
// quedan el logo y el botón de menú, y la misma lista de enlaces se abre como bandeja (lib/estandar/menu.js). Sin JS,
// los enlaces se muestran en la barra y el botón no aparece. El logo va en claro: la barra siempre es negra.
import { cleanPath } from '../../lib/routes.mjs';
import '../../styles/estandar.css';
import '../../styles/estandar-componentes.css';

interface Enlace { href: string; texto: string }
interface Props {
  /** Logo en claro para fondo negro. width y height son los del archivo: evitan el salto de layout. */
  logo: { src: string; alt: string; width: number; height: number };
  enlaces: Enlace[];
}
const { logo, enlaces } = Astro.props;
// logo.alt es el nombre del enlace al inicio («<alt>, inicio»): vacío, el lector de pantalla diría «, inicio».
const lleno = (v: unknown) => typeof v === 'string' && v.trim() !== '';
const faltan = [!logo?.src && 'logo.src', !lleno(logo?.alt) && 'logo.alt (el nombre del sitio, no puede ir vacío)',
  !logo?.width && 'logo.width', !logo?.height && 'logo.height',
  !Array.isArray(enlaces) && 'enlaces (una lista, que puede ir vacía)'].filter(Boolean);
if (faltan.length) throw new Error(`NavGlobal: falta ${faltan.join(', ')}.`);
enlaces.forEach((e, i) => {
  const faltanEnlace = [!lleno(e?.href) && 'href', !lleno(e?.texto) && 'texto'].filter(Boolean);
  if (faltanEnlace.length) throw new Error(`NavGlobal: al enlace ${i + 1} le falta ${faltanEnlace.join(', ')}.`);
});
// aria-current="page" en el enlace a la página actual. Se comparan rutas limpias con / final: con build.format
// "preserve", Astro.url.pathname de una página suelta termina en .html (/demo-estandar.html). Un enlace con # apunta
// a una sección y no se marca (#claro, /#contacto), ni uno que no empiece con /.
const conBarra = (ruta: string) => { const r = cleanPath(ruta); return r.endsWith('/') ? r : `${r}/`; };
const paginaActual = conBarra(Astro.url.pathname);
const esActual = (href: string) => href.startsWith('/') && !href.startsWith('//') && !href.includes('#') && conBarra(href.split('?')[0]) === paginaActual;
---
<header class="std-gnav" data-std-gnav>
  <nav class="std-gnav__in" aria-label="Principal">
    <a class="std-gnav__logo" href="/" aria-label={`${logo.alt}, inicio`}>
      <img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} />
    </a>
    <button class="std-gnav__menu" type="button" aria-label="Menú" aria-expanded="false" aria-controls="std-gnav-enlaces" data-std-menu>
      <svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <path class="std-gnav__linea" d="M1 2h16" /><path class="std-gnav__linea" d="M1 10h16" />
      </svg>
    </button>
    <ul class="std-gnav__enlaces" id="std-gnav-enlaces">
      {enlaces.map((e) => <li><a href={e.href} aria-current={esActual(e.href) ? 'page' : undefined}>{e.texto}</a></li>)}
    </ul>
  </nav>
</header>

<script>import '../../lib/estandar/menu.js';</script>
