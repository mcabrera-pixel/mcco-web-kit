{
  "name": "@mcco/web-kit",
  "version": "1.3.1",
  "description": "Kit compartido de las webs MCCO Group: el Estándar Web v2 (layouts y componentes Astro, entidad del grupo, endpoints SEO/GEO, verificador mcco-check, generador de _headers y workflows reutilizables) y el estándar visual del grupo, Apple + antigravity (hoja, componentes, nube y campo). Incluye distribución completa sin Astro, CSS compartido y módulos ESM minificados.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcabrera-pixel/mcco-web-kit.git"
  },
  "keywords": ["astro-component", "mcco", "withastro"],
  "exports": {
    "./config": "./config/astro.mjs",
    "./schemas": "./content/schemas.ts",
    "./layouts/*": "./layouts/*",
    "./components/*": "./components/*",
    "./pages/*": "./pages/*",
    "./data/*": "./data/*",
    "./endpoints/*": "./endpoints/*",
    "./lib/*": "./lib/*",
    "./styles/*": "./styles/*",
    "./functions/*": "./functions/*",
    "./dist/estandar/*": "./dist/estandar/*"
  },
  "bin": {
    "mcco-check": "scripts/check.mjs",
    "mcco-parity": "scripts/parity.mjs",
    "mcco-headers": "scripts/headers.mjs",
    "mcco-sitio": "scripts/sitio-ci.mjs",
    "mcco-estandar-copiar": "scripts/estandar-copiar.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build:estandar": "node scripts/estandar-build.mjs",
    "check:estandar": "node scripts/estandar-verificar.mjs",
    "verificar": "npm test && npm run build:estandar && npm run check:estandar && node test/estandar-html.verificar.mjs"
  },
  "files": [
    "config", "content", "layouts", "components", "pages", "data", "endpoints",
    "lib", "styles", "scripts", "functions", "docs", "README.md", "dist/estandar"
  ],
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
