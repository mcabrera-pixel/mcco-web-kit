---
// Galería del estándar: fotos, ilustraciones, capturas de simulación y videos, cada uno con su rótulo de origen (R11)
// y un pie opcional, en tarjetas de 18 px de radio. Dos formatos:
//   cuadros (por defecto)  cuadros iguales en 4:3, recortados al centro, tres por fila (dos en ≤ 833 px, uno en
//                          ≤ 640 px). Para fotos e ilustraciones.
//   mosaico                cada imagen en su proporción y sin recorte, en filas de alto parejo (unos 240 px, con tope
//                          de 320), y nunca más ancha que su archivo. Para capturas chicas o de tamaños distintos: no
//                          se estiran. En ≤ 640 px no hay tope de alto: una imagen sola en su fila llena el ancho,
//                          salvo que su archivo sea más angosto.
// Video: muted, playsinline, loop y preload="none", con poster obligatorio (R12). lib/visual/video.js lo descarga y lo
// reproduce solo a la vista y sin movimiento reducido ni ahorro de datos (Save-Data); si no, queda el poster y el botón
// para reproducirlo. Sin JS se ve el poster. Un video real lleva «Video de faena», como VideoBanda: no es una foto.
import '../../styles/estandar.css';
import { ROTULOS, rotuloDe } from '../../lib/estandar/rotulos.mjs';

interface Item {
  tipo: 'imagen' | 'video';
  /** Archivo de la imagen, o el MP4 (H.264) o WebM del video. */
  src: string;
  /** Obligatorio en un video: lo que se ve antes de que cargue y cuando no se reproduce solo. */
  poster?: string;
  /** Texto alternativo de la imagen. En un video, qué muestra (su aria-label), y no puede ir vacío. */
  alt: string;
  width: number;
  height: number;
  origen: keyof typeof ROTULOS;
  pie?: string;
}
interface Props {
  items: Item[];
  formato?: 'cuadros' | 'mosaico';
}
const { items = [], formato = 'cuadros' } = Astro.props;
if (formato !== 'cuadros' && formato !== 'mosaico') throw new Error(`Galeria: formato "${formato}" no existe (cuadros, mosaico).`);
for (const it of items) {
  if (it?.tipo !== 'imagen' && it?.tipo !== 'video') throw new Error(`Galeria ${it?.src ?? ''}: tipo "${it?.tipo}" no existe (imagen, video).`);
  const video = it.tipo === 'video';
  const faltan = [!it.src && 'src', typeof it.alt !== 'string' && 'alt', video && it.alt === '' && 'alt (qué muestra el video)',
    !(it.width > 0) && 'width', !(it.height > 0) && 'height', video && !it.poster && 'poster'].filter(Boolean);
  if (faltan.length) throw new Error(`Galeria ${it.src ?? ''}: falta ${faltan.join(', ')}.`);
  rotuloDe(it.origen);
}
const rotulo = (it: Item) => (it.tipo === 'video' && it.origen === 'real' ? 'Video de faena' : rotuloDe(it.origen));
const tipoVideo = (src: string) => (/\.webm(?:[?#]|$)/i.test(src) ? 'video/webm' : 'video/mp4');
---
{items.length > 0 && (
  <ul class:list={['std-galeria', `std-galeria--${formato}`]} role="list">
    {items.map((it) => (
      <li class="std-galeria__item" style={`--w: ${it.width}; --h: ${it.height}`}>
        <figure class="std-galeria__figura" data-origen={it.origen}>
          <div class="std-galeria__marco" data-mcco-video={it.tipo === 'video' ? '' : undefined}>
            {it.tipo === 'video' ? (
              <video muted playsinline loop preload="none" poster={it.poster} aria-label={it.alt}
                width={it.width} height={it.height} data-origen={it.origen}>
                <source src={it.src} type={tipoVideo(it.src)} />
              </video>
            ) : (
              <img src={it.src} alt={it.alt} width={it.width} height={it.height} loading="lazy" decoding="async" data-origen={it.origen} />
            )}
            <span class="std-rotulo" data-rotulo>{rotulo(it)}</span>
            {it.tipo === 'video' && (
              <button type="button" class="std-galeria__boton" data-video-boton aria-pressed="false" hidden>Pausar video <span aria-hidden="true">Ⅱ</span></button>
            )}
          </div>
          {it.pie && <figcaption class="std-galeria__pie">{it.pie}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>
)}

<script>import '../../lib/visual/video.js';</script>

<style>
  .std-galeria {
    display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: center; gap: 16px;
    max-width: 1024px; margin: 40px auto 0; padding: 0; list-style: none;
  }
  .std-galeria__figura { margin: 0; }
  .std-galeria__marco {
    position: relative; overflow: hidden;
    border-radius: var(--std-radio-tarjeta); background: var(--std-parchment);
  }
  .std-galeria__marco img, .std-galeria__marco video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .std-galeria__pie { margin: 10px 0 0; font-size: 14px; line-height: 1.43; letter-spacing: -.016em; color: var(--std-gris); }
  :global([data-std-oscuro]) .std-galeria__marco { background: var(--std-negro-1); }
  :global([data-std-oscuro]) .std-galeria__pie { color: #a1a1a6; }

  /* Cuadros: iguales y sin crecer, así una fila incompleta queda centrada. */
  .std-galeria--cuadros .std-galeria__item { flex: 0 1 calc((100% - 32px) / 3); }
  .std-galeria--cuadros .std-galeria__marco { aspect-ratio: 4 / 3; }

  /* Mosaico: cada ítem crece en proporción a su ancho relativo (--w / --h), así todos los de una fila quedan del
     mismo alto. El tope de 320 px de alto evita que la última fila crezca de más y el del ancho del archivo, que se
     estire. */
  .std-galeria--mosaico { gap: 12px; }
  .std-galeria--mosaico .std-galeria__item {
    flex: calc(var(--w) / var(--h)) 1 calc(var(--w) / var(--h) * 240px);
    max-width: min(calc(var(--w) * 1px), calc(var(--w) / var(--h) * 320px));
  }
  .std-galeria--mosaico .std-galeria__marco { aspect-ratio: var(--w) / var(--h); }

  /* Botón del video, que video.js muestra: círculo de 44 px como el rótulo, abajo a la izquierda. Su texto queda
     fuera de la vista y lo leen los lectores de pantalla; el ícono de pausa o de reproducir lo dibuja el ::before
     según aria-pressed (true: pausado por la persona o sin reproducción automática). */
  .std-galeria__boton {
    position: absolute; left: 12px; bottom: 12px;
    width: 44px; height: 44px; padding: 0; overflow: hidden;
    border: 0; border-radius: 50%; background: rgba(210,210,215,.72);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    color: var(--std-tinta); white-space: nowrap; text-indent: 44px; cursor: pointer;
    transition: transform .12s ease;
  }
  .std-galeria__boton:active { transform: scale(.95); }
  .std-galeria__boton[hidden] { display: none; }
  .std-galeria__boton :global(span) { display: none; }
  .std-galeria__boton::before { content: ""; position: absolute; top: 50%; left: 50%; }
  .std-galeria__boton[aria-pressed='false']::before {
    width: 12px; height: 14px; margin: -7px 0 0 -6px; border-left: 4px solid; border-right: 4px solid;
  }
  .std-galeria__boton[aria-pressed='true']::before {
    width: 0; height: 0; margin: -8px 0 0 -5px;
    border-left: 13px solid; border-top: 8px solid transparent; border-bottom: 8px solid transparent;
  }

  @media (max-width: 833px) {
    .std-galeria--cuadros .std-galeria__item { flex-basis: calc((100% - 16px) / 2); }
  }
  @media (max-width: 640px) {
    .std-galeria { margin-top: 32px; }
    .std-galeria--cuadros .std-galeria__item { flex-basis: 100%; }
    .std-galeria--mosaico .std-galeria__item { max-width: calc(var(--w) * 1px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .std-galeria__boton { transition: none; }
  }
</style>
