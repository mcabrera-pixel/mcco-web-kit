---
// Layout de artículo (blog/guía): Base con el cuerpo de ArticuloBlog (cápsula GEO, contenido, fuentes, FAQ, relacionados,
// CTA) y el JSON-LD BlogPosting + BreadcrumbList en el <head> (+ FAQPage vía <Faq>). Recibe la entrada de la colección.
// El primer hijo del <body> es el enlace «Saltar al contenido» (v1.4.2), en el idioma de la página, al <main>. Post no
// carga la hoja del estándar: su clase y su id son del kit general (mcco-) y su estilo va en el <style> de abajo.
// Cromo del sitio (v1.5.0): slots head (favicon), nav y footer, y footer={false} quita el bloque Grupo. Un sitio con su
// propio layout no necesita Post: pone ArticuloBlog dentro de ese layout.
import type { ComponentProps } from 'astro/types';
import Base from './Base.astro';
import ArticuloBlog from '../components/ArticuloBlog.astro';
import { loadSite } from '../lib/site.mjs';
import { datosArticulo } from '../lib/articulo.mjs';
import { esEspanol } from '../lib/idioma.mjs';

interface Props extends Pick<ComponentProps<typeof Base>, 'lang' | 'ogTitle' | 'ogDescription' | 'ogUrl' | 'robots' | 'footer' | 'bodyClass'> {
  post: any; section?: string; sectionTitle?: string; wordCount?: number; zona?: string;
}
const site = loadSite();
const { post, section = 'blog', sectionTitle = 'Blog', wordCount, zona, lang = site.lang, ogTitle, ogDescription, ogUrl, robots, footer, bodyClass } = Astro.props;
const d = post.data;
const a = datosArticulo(post, { pathname: Astro.url.pathname, lang, section, sectionTitle, wordCount, zona });
---
<Base title={d.seo_title ?? d.title} description={d.description} type="article" ogImage={a.hero}
      published={a.published} modified={a.modified} jsonld={[a.blogPosting, a.breadcrumb]}
      lang={lang} ogTitle={ogTitle} ogDescription={ogDescription} ogUrl={ogUrl} robots={robots} footer={footer} bodyClass={bodyClass}>
  <slot name="head" slot="head" />
  <a class="mcco-saltar" href="#mcco-contenido">{esEspanol(lang) ? 'Saltar al contenido' : 'Skip to content'}</a>
  <slot name="nav" />
  <main id="mcco-contenido" class="mcco-post">
    <ArticuloBlog post={post} section={section} sectionTitle={sectionTitle} wordCount={wordCount} lang={lang} zona={zona} jsonld={false}><slot /></ArticuloBlog>
  </main>
  <slot name="footer" />
</Base>
<style>
  /* Enlace de salto: el mismo comportamiento que .std-saltar del estándar, con colores fijos (AA en cualquier tema).
     Fuera de la vista hasta recibir foco; con foco, arriba a la izquierda, sobre la barra del sitio, con 44 px de alto. */
  .mcco-saltar {
    position: fixed; top: 8px; left: 8px; z-index: 1000; box-sizing: border-box;
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 22px;
    border: 1px solid #1d1d1f; border-radius: 980px; background: #fff; color: #1d1d1f;
    font: 400 17px/1 var(--mcco-font-body); text-decoration: none;
    transform: translateY(calc(-100% - 16px));
  }
  .mcco-saltar:focus { transform: none; outline: 2px solid #1d1d1f; outline-offset: 2px; }
  .mcco-post { max-width: 760px; margin: 0 auto; padding: calc(var(--mcco-space) * 2) var(--mcco-space); font-family: var(--mcco-font-body); color: var(--mcco-color-text); }
</style>
