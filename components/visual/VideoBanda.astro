---
// Banda de video real (sistema visual v1.1): a ancho completo ('banda') o partida video + texto ('partido').
// muted playsinline loop, preload="none": el video se descarga recién cuando entra en pantalla y se reproduce.
// Sin autoplay con prefers-reduced-motion ni con Save-Data (queda el poster y un botón para reproducir).
// Sin JS queda el poster (sin controles nativos: su árbol interno encarece el primer render). El rótulo de origen
// es visible ("Video de faena" por defecto).
import '../../styles/tokens.css';
import '../../styles/visual.css';

interface Fuente { src: string; type?: string }
interface Props {
  /** Archivo MP4 (H.264). Para varias fuentes (WebM + MP4) usa `fuentes`. */
  src?: string;
  fuentes?: Fuente[];
  /** Obligatorio: imagen que se ve antes de cargar y cuando no hay autoplay. */
  poster: string;
  /** Qué muestra el video (aria-label). */
  etiqueta: string;
  rotulo?: string;
  formato?: 'banda' | 'partido';
  /** En 'partido', de qué lado va el video. */
  lado?: 'izquierda' | 'derecha';
  /** Relación de aspecto del cuadro ('16 / 9'). En 'banda' se usa el alto. */
  proporcion?: string;
  /** Alto de la banda a ancho completo. */
  alto?: string;
  id?: string;
  class?: string;
}
const {
  src, fuentes, poster, etiqueta, rotulo = 'Video de faena', formato = 'banda', lado = 'izquierda',
  proporcion = '16 / 9', alto = 'clamp(280px, 56vw, 620px)', id, class: clase,
} = Astro.props;
if (!poster) throw new Error('VideoBanda: `poster` es obligatorio.');
if (!etiqueta) throw new Error('VideoBanda: `etiqueta` es obligatoria (describe lo que muestra el video).');
const lista: Fuente[] = fuentes ?? (src ? [{ src, type: 'video/mp4' }] : []);
if (!lista.length) throw new Error('VideoBanda: falta `src` o `fuentes`.');
const tipo = (f: Fuente) => f.type ?? (f.src.endsWith('.webm') ? 'video/webm' : 'video/mp4');
const conTexto = Astro.slots.has('default');
---
<section class:list={['mcco-video', `mcco-video--${formato}`, lado === 'derecha' && 'mcco-video--derecha', clase]} id={id}
  data-mcco-video data-mcco-visual="video" style={`--mcco-video-alto: ${alto}; --mcco-video-proporcion: ${proporcion};`}>
  <div class="mcco-video__cuadro">
    <video muted playsinline loop preload="none" poster={poster} aria-label={etiqueta} data-origen="real">
      {lista.map((f) => <source src={f.src} type={tipo(f)} />)}
    </video>
    <span class="mcco-rotulo" data-rotulo data-en="sup-izq">{rotulo}</span>
    <button type="button" class="mcco-control mcco-video__boton" data-video-boton aria-pressed="false" hidden>Pausar video <span aria-hidden="true">Ⅱ</span></button>
    {formato === 'banda' && conTexto && <div class="mcco-video__sobre"><slot /></div>}
  </div>
  {formato === 'partido' && conTexto && <div class="mcco-video__texto"><slot /></div>}
</section>

<script>import '../../lib/visual/video.js';</script>

<style>
  .mcco-video { color: var(--mcco-color-text); }
  .mcco-video__cuadro { position: relative; overflow: hidden; background: #111; }
  .mcco-video__cuadro video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .mcco-video__boton { position: absolute; right: 0.75rem; bottom: 0.75rem; z-index: 3; }
  .mcco-video__boton[hidden] { display: none; }

  /* Banda a ancho completo: alto fijo (sin saltos de layout), texto opcional sobre un degradado oscuro. */
  .mcco-video--banda .mcco-video__cuadro { height: var(--mcco-video-alto); }
  .mcco-video__sobre {
    position: absolute; inset: auto 0 0 0; z-index: 2; color: #fff;
    padding: clamp(1.25rem, 4vw, 3rem) max(var(--mcco-space), calc((100% - var(--mcco-maxw)) / 2 + var(--mcco-space))) clamp(3.5rem, 6vw, 4.5rem);
    background: linear-gradient(to top, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0.45) 60%, transparent);
  }
  .mcco-video__sobre :global(h2) { font-family: var(--mcco-font-display); font-size: clamp(1.6rem, 3.4vw, 2.75rem); line-height: 1.08; margin: 0 0 0.5rem; max-width: 18em; }
  .mcco-video__sobre :global(p) { margin: 0; max-width: 36em; color: rgb(255 255 255 / 0.88); }

  /* Partido: video + texto en dos columnas; en móvil el video va arriba. */
  .mcco-video--partido {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(1.25rem, 4vw, 3.5rem); align-items: center;
    max-width: var(--mcco-maxw); margin: 0 auto; padding: clamp(2rem, 5vw, 4rem) var(--mcco-space);
  }
  .mcco-video--partido .mcco-video__cuadro { aspect-ratio: var(--mcco-video-proporcion); border-radius: var(--mcco-radius); }
  .mcco-video--derecha { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .mcco-video--derecha .mcco-video__cuadro { order: 2; }
  .mcco-video__texto :global(h2) { font-family: var(--mcco-font-display); font-size: clamp(1.5rem, 2.8vw, 2.4rem); line-height: 1.1; margin: 0 0 0.75rem; }
  .mcco-video__texto :global(p) { color: var(--mcco-color-muted); margin: 0 0 1rem; }
  @media (max-width: 760px) {
    .mcco-video--partido, .mcco-video--derecha { grid-template-columns: 1fr; }
    .mcco-video--derecha .mcco-video__cuadro { order: 0; }
  }
</style>
