---
// Layout de artículo (blog/guía): cabecera, cápsula GEO, contenido, fuentes, FAQ, relacionados, CTA,
// JSON-LD BlogPosting + BreadcrumbList (+ FAQPage vía <Faq>). Recibe la entrada de la colección.
import Base from './Base.astro';
import AiCapsule from '../components/AiCapsule.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { loadSite } from '../lib/site.mjs';
import { canonicalFor } from '../lib/routes.mjs';

interface Props { post: any; section?: string; sectionTitle?: string; wordCount?: number }
const site = loadSite();
const { post, section = 'blog', sectionTitle = 'Blog', wordCount } = Astro.props;
const d = post.data;
const url = canonicalFor(Astro.url.pathname, site.domain);
const author = d.author ?? site.content.author ?? { name: 'MCCO Group', role: '' };
const published = d.date.toISOString().slice(0, 10);
const modified = (d.updated ?? d.date).toISOString().slice(0, 10);
const words = wordCount ?? (post.body ? post.body.split(/\s+/).filter(Boolean).length : undefined);
const minutes = words ? Math.max(1, Math.round(words / 200)) : undefined;
const hero = new URL(d.hero?.src ?? site.seo.og_image ?? '/og.webp', site.domain).href;
const logo = new URL(site.seo.logo ?? '/logo.png', site.domain).href;

const blogPosting: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  image: hero,
  datePublished: published,
  dateModified: modified,
  inLanguage: site.lang,
  author: { '@type': 'Person', name: author.name, jobTitle: author.role, worksFor: { '@id': `${site.domain}/#organization` } },
  publisher: { '@type': 'Organization', name: site.name, url: `${site.domain}/`, logo: { '@type': 'ImageObject', url: logo } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};
if (words) blogPosting.wordCount = words;
if (d.sources?.length) blogPosting.citation = d.sources.map((s: any) => s.url);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: sectionTitle, item: `${site.domain}/${section}/` },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};
const fecha = d.date.toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={d.seo_title ?? d.title} description={d.description} type="article" ogImage={hero}
      published={published} modified={modified} jsonld={[blogPosting, breadcrumb]}>
  <slot name="nav" />
  <main class="mcco-post" data-mcco="post">
    <article>
      <header class="mcco-post__header">
        <nav aria-label="Ruta" class="mcco-post__crumbs">
          <a href="/">Inicio</a> › <a href={`/${section}/`}>{sectionTitle}</a> › <span>{d.category}</span>
        </nav>
        <h1>{d.title}</h1>
        <p class="mcco-post__meta">
          Por <strong>{author.name}</strong>{author.role && <span> — {author.role}</span>}
          · <time datetime={published}>{fecha}</time>{minutes && <span> · {minutes} min de lectura</span>}
        </p>
        {d.hero && <img class="mcco-post__hero" src={d.hero.src} alt={d.hero.alt} width="1200" height="675" fetchpriority="high" />}
      </header>
      <AiCapsule text={d.capsule} />
      <div class="mcco-post__content"><slot /></div>
      {d.sources?.length > 0 && (
        <section class="mcco-post__sources">
          <h2>Fuentes</h2>
          <ul>{d.sources.map((s: any) => <li><a href={s.url} rel="noopener nofollow">{s.title}</a></li>)}</ul>
        </section>
      )}
      <Faq items={d.faq} />
      <section class="mcco-post__related">
        <h2>Servicios relacionados</h2>
        <ul>
          {d.related.map((r: any) => <li><a href={r.url}>{r.anchor}</a></li>)}
          {d.sister && <li><a href={d.sister.url} rel="noopener">{d.sister.anchor}</a> <small>({d.sister.site})</small></li>}
        </ul>
      </section>
      <Cta ref={d.title} />
    </article>
  </main>
  <slot name="footer" />
</Base>
<style>
  .mcco-post { max-width: 760px; margin: 0 auto; padding: calc(var(--mcco-space) * 2) var(--mcco-space); font-family: var(--mcco-font-body); color: var(--mcco-color-text); }
  .mcco-post__crumbs { font-size: 0.8125rem; color: var(--mcco-color-muted); margin-bottom: 0.75rem; }
  .mcco-post__crumbs a { color: inherit; }
  .mcco-post h1 { font-family: var(--mcco-font-display); font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.15; margin: 0 0 0.5rem; }
  .mcco-post__meta { color: var(--mcco-color-muted); font-size: 0.9375rem; margin: 0 0 var(--mcco-space); }
  .mcco-post__hero { width: 100%; height: auto; border-radius: var(--mcco-radius); margin: var(--mcco-space) 0; }
  .mcco-post__content :global(h2) { margin-top: calc(var(--mcco-space) * 2); }
  .mcco-post__content :global(table) { width: 100%; border-collapse: collapse; margin: var(--mcco-space) 0; font-size: 0.9375rem; }
  .mcco-post__content :global(th), .mcco-post__content :global(td) { border: 1px solid var(--mcco-color-border); padding: 0.5rem 0.625rem; text-align: left; vertical-align: top; }
  .mcco-post__content :global(img) { max-width: 100%; height: auto; }
  .mcco-post__sources ul, .mcco-post__related ul { padding-left: 1.25rem; }
</style>
