---
// Layout base: <Head> estándar + analítica + slot + bloque Grupo MCCO.
import type { ComponentProps } from 'astro/types';
import Head from '../components/Head.astro';
import Analytics from '../components/Analytics.astro';
import FooterGrupo from '../components/FooterGrupo.astro';
import { loadSite } from '../lib/site.mjs';
import '../styles/tokens.css';
interface Props extends ComponentProps<typeof Head> {
  footer?: boolean;
  bodyClass?: string;
}
const site = loadSite();
const { footer = true, bodyClass = '', lang = site.lang, ...head } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <Head {...head} lang={lang}><slot name="head" /></Head>
    <Analytics />
  </head>
  <body class={bodyClass}>
    <slot />
    {footer && <FooterGrupo />}
    <slot name="body-end" />
  </body>
</html>
