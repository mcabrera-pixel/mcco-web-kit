---
// Sub-navegación del estándar: esmerilada, fija arriba al bajar, 52 px (48 en ≤ 640 px) con el título del sitio,
// enlaces de 12 px y la acción principal en píldora chica, siempre visible. En ≤ 833 px quedan el título y la acción;
// en ≤ 640 px la acción usa su textoCorto si lo tiene. Sobre un bloque negro a todo el ancho pasa a su versión oscura
// (lib/estandar/subnav.js). Va como hija directa de <body>: el position: sticky se mide contra su contenedor.
import '../../styles/estandar.css';
import '../../styles/estandar-componentes.css';

interface Enlace { href: string; texto: string }
interface Props {
  titulo: string;
  enlaces: Enlace[];
  accion: Enlace & { textoCorto?: string };
}
const { titulo, enlaces, accion } = Astro.props;
if (!titulo || !accion?.href || !accion?.texto) throw new Error('SubNav: falta titulo o accion { href, texto }.');
if (!Array.isArray(enlaces)) throw new Error('SubNav: falta enlaces (una lista, que puede ir vacía).');
const lleno = (v: unknown) => typeof v === 'string' && v.trim() !== '';
enlaces.forEach((e, i) => {
  const faltan = [!lleno(e?.href) && 'href', !lleno(e?.texto) && 'texto'].filter(Boolean);
  if (faltan.length) throw new Error(`SubNav: al enlace ${i + 1} le falta ${faltan.join(', ')}.`);
});
---
<div class="std-subnav">
  <div class="std-subnav__in">
    <span class="std-subnav__titulo">{titulo}</span>
    <nav class="std-subnav__nav" aria-label="Secciones">
      {enlaces.map((e) => <a class="std-subnav__enlace" href={e.href}>{e.texto}</a>)}
      <a class="std-pildora std-pildora--chica std-subnav__accion" href={accion.href}>
        {accion.textoCorto
          ? <Fragment><span class="std-subnav__largo">{accion.texto}</span><span class="std-subnav__corto">{accion.textoCorto}</span></Fragment>
          : accion.texto}
      </a>
    </nav>
  </div>
</div>

<script>import '../../lib/estandar/subnav.js';</script>
