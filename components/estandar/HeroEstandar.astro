---
// Hero del estándar: blanco, H1 de 56 px (el LCP), bajada, acciones y, con `nube`, el lugar donde la nube antigravity
// arma el primer activo (NubeAncla) con su rótulo de origen debajo. Para cortes de línea o énfasis en el título se usa
// el slot "titulo". Con `campo`, el campo antigravity (CampoAntigravity) ocupa todo el hero detrás del texto: la capa
// va en z-index 0 y el contenido en z-index 1, sin fondos, así los guiones pasan entre las letras. La píldora fantasma
// lleva fondo blanco para leerse sobre ellos. Con nube o campo, el hero lleva su propio botón para pausar el movimiento
// (WCAG 2.2.2): pausa la nube y el campo con la pausa común (lib/estandar/pausa.js), a la par con el de la historia.
import '../../styles/estandar.css';
import Acciones from './Acciones.astro';
import NubeAncla from './NubeAncla.astro';
import CampoAntigravity from './CampoAntigravity.astro';
import type { ComponentProps } from 'astro/types';

interface Props {
  /** Texto del H1. Para cortes de línea o énfasis usa el slot "titulo". */
  titulo?: string;
  bajada?: string;
  acciones: ComponentProps<typeof Acciones>['acciones'];
  /** Imagen fija de la nube: la que se ve sin WebGL o con movimiento reducido. */
  nube?: ComponentProps<typeof NubeAncla>;
  /** Rótulo de origen bajo la nube. */
  rotulo?: string;
  /** Campo antigravity detrás del texto: guiones en anillos que siguen al mouse con retraso. */
  campo?: boolean;
}
const { titulo, bajada, acciones, nube, rotulo = 'Ilustración en nube de puntos.', campo = false } = Astro.props;
if (!titulo && !Astro.slots.has('titulo')) throw new Error('HeroEstandar: falta `titulo` o el slot "titulo".');
---
<section class="std-hero" aria-labelledby="std-hero-titulo">
  {campo && <CampoAntigravity />}
  <h1 class="std-h1" id="std-hero-titulo"><slot name="titulo">{titulo}</slot></h1>
  {bajada && <p class="std-lead std-hero__bajada">{bajada}</p>}
  <Acciones acciones={acciones} />
  {nube && (
    <figure class="std-hero__nube">
      <NubeAncla respaldo={nube.respaldo} />
      <figcaption class="std-fina std-hero__rotulo" data-rotulo>{rotulo}</figcaption>
    </figure>
  )}
  {(nube || campo) && <button type="button" class="std-hero__pausa" data-std-pausa>Pausar movimiento</button>}
</section>

<style>
  .std-hero { position: relative; padding: 56px 22px 0; background: var(--std-blanco); text-align: center; }
  /* El contenido va sobre el campo (z-index 0). :global alcanza también la raíz de Acciones, que es de otro componente. */
  .std-hero > :global(:not([data-std-campo], .std-hero__pausa)) { position: relative; z-index: 1; }
  .std-hero__bajada { color: var(--std-tinta-80); }
  .std-hero :global(.std-pildora--fantasma) { background: var(--std-blanco); }
  .std-hero__nube { margin: 0; }
  .std-hero__rotulo { margin: 0 auto; padding-bottom: 8px; }
  /* Pausa del movimiento: en la esquina superior derecha, dentro del aire sobre el título, así no toca el texto, las
     acciones ni la nube. Píldora chica como la de la historia, con fondo propio (los guiones no pasan bajo la letra),
     44 px de área táctil (::before) y z-index 3, sobre el lienzo de la nube (z-index 2). Se ve solo con algo
     moviéndose en el hero: la nube (data-estado="nube", nube.js) o el campo (data-estado="activo", campo.js). */
  .std-hero__pausa {
    display: none; position: absolute; top: 7px; right: 22px; z-index: 3;
    padding: 9px 14px; border: 0; border-radius: 980px;
    background: var(--std-parchment); color: var(--std-tinta-80);
    font: 400 12px/1 var(--std-fuente); letter-spacing: -.01em; cursor: pointer;
    transition: transform .12s ease;
  }
  .std-hero__pausa:active { transform: scale(.95); }
  .std-hero__pausa::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 44px; margin-top: -22px; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.std-hero:has([data-std-nube="hero"][data-estado="nube"], [data-std-campo][data-estado="activo"])) .std-hero__pausa {
      display: block;
    }
  }
  @media (max-width: 640px) {
    .std-hero { padding: 44px 16px 0; }
    .std-hero__pausa { right: 16px; }
  }
</style>
